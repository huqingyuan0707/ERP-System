# 复制为 .env 后修改真实值，禁止把真实密钥提交到 Git

# 数据库
DB_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://erp:change_me@postgres:5432/erp

# 本地无 Postgres 时可改用 SQLite 直接跑通：
# DATABASE_URL=sqlite+aiosqlite:///./erp.db

# Redis
REDIS_URL=redis://redis:6379/0

# 对象存储
MINIO_USER=minioadmin
MINIO_PASSWORD=change_me

# 安全（注意：后端 config.py 读取的字段是 SECRET_KEY，不是 JWT_SECRET）
SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 阿里云容器镜像服务 ACR 地址（含命名空间），格式：registry.<区域>.aliyuncs.com/<命名空间>
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com/your-namespace

# 镜像标签：必须与 CI 推送的 tag 一致，否则 compose 会拉不到镜像
# 流水线默认推送 latest；灰度发布时填具体 tag（如 commit SHA）并同步修改这里
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# ACR 登录凭证（用户名/密码）放在同目录的 .acr.env（权限 600），不要写进本文件，
# 否则会被 docker-compose 的 env_file 注入到业务容器：
#   ACR_USERNAME=你的 ACR 访问凭证用户名
#   ACR_PASSWORD=你的 ACR 访问凭证密码
