# pylint 静态检查配置
#
# 【定位】pylint 在本方案中只负责「语义正确性」这一层：
#   - 查空引用、非法调用、参数不匹配、未定义变量等真实缺陷
#   - 不重复 ruff 已覆盖的 import 排序 / 基础风格问题
#   - 不重复 SonarQube 已覆盖的复杂度、重复代码、安全漏洞扫描
#
# 【重要】pylint 退出码是位掩码：1=致命 2=错误 4=警告 8=重构 16=约定 32=用法错误
#   门禁脚本不使用 --fail-on 判定，因为实测发现：
#     `--fail-on=E0602` 会「复活」被 disable 的检查（退出码含错误位），
#     而 `--fail-on=E`（类别）不会。两种语义不一致，极易误阻断。
#   门禁改为解析 JSON 输出后自行分级判定（见 scripts/ci/quality_gate.py）。
#
# 用法：pylint --rcfile backend/pylintrc --output-format=json backend/app

[MAIN]
# 只检查后端应用包，排除迁移脚本与报告目录
ignore-paths = ^backend/(alembic|reports|\.venv)/

# 加载顺序：保证目录结构类检查能拿到完整上下文
recursive = yes

# 把后端目录加入模块搜索路径，保证 `import app.xxx` 能被解析。
# 注意：pylint 的 init-hook 不支持 %(rcfile)s 之类的变量替换，
#       这里的路径是相对「执行命令时的当前目录」的，
#       因此 CI 与本地都必须在 backend 目录下执行本命令。
init-hook = 'import sys; sys.path.insert(0, ".")'

# 单个文件内重复代码的最小行数：默认 4 行太敏感，会把 ERP 里
# 「列表查询 + 分页 + 统一响应」这类刻意重复的模板代码全部报出来
min-similarity-lines = 8

# 加载 docparams 扩展，用于检查函数文档中的参数说明
load-plugins = pylint.extensions.docparams


[MESSAGES CONTROL]
# ------------------------------------------------------------------
# 禁用列表：每一项都注明「为什么禁」，避免以后被当成垃圾配置删掉
# ------------------------------------------------------------------
disable =
    # ---- 与 ruff 重复的部分（ruff 已按 E/F/I/B/UP/C4/SIM 规则检查过）----
    missing-final-newline,
    trailing-newlines,
    wrong-import-order,
    ungrouped-imports,
    wrong-import-position,
    duplicate-code,
    consider-using-f-string,
    super-with-arguments,
    useless-object-inheritance,

    # ---- 本仓库存量现状：docstring 缺失过多，先降级为告警 ----
    # 实测基线：missing-module-docstring 73 处、missing-function-docstring 大量存在。
    # 一次性阻断会把所有 MR 卡死，先不阻断，由报告进看板跟踪存量债务。
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,

    # ---- 与本仓库 ruff line-length=100 统一，交给 ruff 处理 ----
    line-too-long,
    trailing-whitespace,
    superfluous-parens,

    # ---- FastAPI / SQLAlchemy 动态特性导致的误报 ----
    broad-exception-caught,
    broad-exception-raised,
    consider-using-dict-items,
    logging-fstring-interpolation,
    import-outside-toplevel,
    global-statement,
    unspecified-encoding,
    consider-using-with,
    useless-object-inheritance,

    # ---- 设计类检查：交给 SonarQube 的复杂度 / 设计规则 ----
    too-many-arguments,
    too-many-positional-arguments,
    too-many-instance-attributes,
    too-many-public-methods,
    too-few-public-methods,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-nested-blocks,
    too-many-ancestors,
    cyclic-import,

    # ---- 其它 ----
    fixme,
    lost-exception,
    arguments-differ,
    keyword-arg-before-vararg


[REPORTS]
# 报告中不输出 score 排名：门禁只关心具体问题，不关心 10.00/10 这种总分
score = no


[FORMAT]
# 单行输出，方便被 CI 日志与 JSON 解析脚本消费
max-line-length = 120
indent-string = '    '


[BASIC]
# 命名风格：沿用 Google Python Style Guide 的 snake_case / PascalCase
argument-naming-style = snake_case
attr-naming-style = snake_case
class-attribute-naming-style = any
class-naming-style = PascalCase
const-naming-style = UPPER_CASE
function-naming-style = snake_case
method-naming-style = snake_case
module-naming-style = snake_case
variable-naming-style = snake_case

# 单字母变量名白名单：循环下标与数学推导常用
good-names = i, j, k, n, m, x, y, z, e, ex, _, db, id, ok

# 允许的变量名长度上限（snake_case）
variable-rgx = ^[a-z_][a-z0-9_]{0,63}$
argument-rgx = ^[a-z_][a-z0-9_]{0,63}$
attr-rgx = ^[a-z_][a-z0-9_]{0,63}$


[DESIGN]
# 最大行数：ERP 的 Service 层业务逻辑较长，但超过阈值通常意味着该拆方法
max-args = 8
max-attributes = 15
max-branches = 15
max-locals = 25
max-statements = 80
max-module-lines = 2000
max-parents = 7

# 最小公有方法数：仓储类只有少量公开方法是正常设计
min-public-methods = 0


[VARIABLES]
# ------------------------------------------------------------------
# 【关键】allow-global-unused-variables 必须保持 yes（也是 pylint 的默认值）
#
# 实测坑：若改成 no，pylint 会把「模块级定义、且只被装饰器注册」的
# FastAPI 路由函数判成 unused-variable。实测本仓 74 个端点文件
# 一次性报出 227 条 W0612 假告警，完全淹没真实问题。
#
# 原理：FastAPI 的 @router.get("/xxx") 是把函数注册到路由表，
#       装饰器返回的对象并非「函数本身」，pylint 的变量检查器
#       无法看到该函数名在模块内被消费，于是判定为「未使用的全局变量」。
#
# 设成 yes 后，模块级未使用变量不再告警；函数体内的未使用变量
# 仍由 W0612 报告（不受本选项影响），不影响真实缺陷检出。
# ------------------------------------------------------------------
allow-global-unused-variables = yes

# 虚拟变量名正则：以下划线开头的变量视为「有意留空」，不报未使用
dummy-variables-rgx = ^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$


[EXCEPTIONS]
# 只允许捕获 Exception 与 BaseException 的子类：ERP 允许兜底捕获后
# 交由全局异常处理器转换（与 app/core/exceptions.py 的设计一致）
overgeneral-exceptions = builtins.Exception


[IMPORTS]
# 已知第三方库：避免 pylint 报 import-error
known-third-party = alembic,asyncpg,fastapi,httpx,jose,openpyxl,pydantic,redis,sqlalchemy


[TYPECHECK]
# Pydantic v2 的 BaseModel 有大量魔术方法，pylint 会误报
ignored-classes = BaseModel,DeclarativeBase,APIRouter,AsyncSession
#
# 【重要】此处刻意 **不** 配置 ignored-modules。
# 实测：一旦把 sqlalchemy / fastapi 等列入 ignored-modules，
#       pylint 会连带失去对「模型属性不存在」的推断能力，
#       导致 E1101(no-member) 整体失效。
# 而 E1101 正是本仓门禁最关键的一类检查：它能命中
#   app/repositories/permission.py 中 SysPermission.tenant_id
#   这一「模型没继承 TenantMixin 却按 tenant_id 过滤」的真实缺陷
#   （该缺陷在运行期直接抛 AttributeError）。
# 保留 E1101 的代价是会对 SQLAlchemy 动态属性产生少量误报，
# 这些误报由门禁的「存量基线」机制吸收，不应通过关掉检查来规避。


[STRING]
# 字符串拼接检查：报表导出场景需要拼接，保持关闭
check-str-concat-over-line-jumps = no
