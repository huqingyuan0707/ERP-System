# 复制为 .env 后修改真实值；禁止把真实密钥提交到 Git

# 运行环境：development / test / production
# production 会强制校验 SECRET_KEY 与 DATABASE_URL，并默认关闭 DEBUG。
ENVIRONMENT=development

# 应用
PROJECT_NAME=企业ERP系统
API_V1_PREFIX=/api/v1
# 留空可使用环境默认值：仅 development 且 TESTING=false 时为 true，其余为 false
# DEBUG=

# 数据库：开发环境默认 PostgreSQL（本机实例）
DATABASE_URL=postgresql+asyncpg://erp:change_me@127.0.0.1:5432/erp
# Docker Compose 环境（服务名为 postgres；密码必须与 DB_PASSWORD 一致）：
# DATABASE_URL=postgresql+asyncpg://erp:change_me@postgres:5432/erp
# 仅 development/test 可使用 SQLite；production 会拒绝：
# DATABASE_URL=sqlite+aiosqlite:///./erp.db

# 测试开关：为 true 时连接池使用 NullPool（测试每用例独立事件循环，不可跨循环复用连接）
# 自动化测试也可设置 ENVIRONMENT=test；固定测试密钥与 SQLite 只能用于隔离测试。
TESTING=false

# Redis：留空合法，字典与参数缓存会退化为进程内 TTL 缓存并记录启动警告。
REDIS_URL=
# 本机 Redis：
# REDIS_URL=redis://127.0.0.1:6379/0
# Docker Compose 环境（服务名为 redis）：
# REDIS_URL=redis://redis:6379/0

# 安全：production 的 SECRET_KEY 必须是至少 32 字符的强随机值，不能使用占位/开发值。
SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 首次管理员密码：production 必填，至少 8 位并同时包含字母和数字；仅用于首次空库种子。
INITIAL_ADMIN_PASSWORD=change_me

# CORS 允许来源（JSON 数组）
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
