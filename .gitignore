# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.db
.pytest_cache/
.ruff_cache/
.mypy_cache/
# pytest 覆盖率数据文件：测试产物，不入库
.coverage
.coverage.*
htmlcov/
# pytype 类型检查的中间产物目录
.pytype/

# Node
node_modules/
dist/
*.local

# 环境变量（保留模板与不含密钥的前端构建配置）
.env
.env.*
!.env.example
!frontend/.env.production
!frontend/.env.development

# ACR 登录凭证（服务器端拉取私有镜像用，勿提交）
.acr.env

# IDE / 系统
.idea/
.vscode/
.DS_Store

# 运行日志 / 临时产物
*.log
*.err
.backend.*
.frontend.*
